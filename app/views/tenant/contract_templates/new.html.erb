<% content_for :title, t('tenant.contract_templates.new.page_title') %>
<%= render 'tenant/shared/layout_slots' %>

<div class="container-fluid px-4 py-3">
  <div class="card">
    <div class="card-body">
      <div class="d-flex justify-content-space-between align-items-center mb-3">
        <h1 class="h5 my-0"><%= t('tenant.contract_templates.new.title') %></h1>
        <%= link_to t('tenant.contract_templates.new.back'), tenant_contract_templates_path(tenant_uid: current_tenant.uid), class: 'btn btn-sm btn-secondary mb-0' %>
      </div>

      <%= render 'form',
        template: @template,
        url: tenant_contract_templates_path(tenant_uid: current_tenant.uid),
        method: :post,
        submit_text: t('tenant.contract_templates.new.submit') %>
    </div>
  </div>
</div>
