<div class="card mb-3">
  <div class="card-body">
    <h2 class="h6 mb-3"><%= t("tenant.integration_guides.feishu.configuration.title") %></h2>

    <div class="mb-3">
      <label class="form-label text-secondary"><%= t("tenant.integration_guides.feishu.configuration.app_id") %></label>
      <div><%= feishu_enterprise.app_id.presence || t("tenant.integration_guides.feishu.configuration.not_configured") %></div>
    </div>

    <div class="mb-3">
      <label class="form-label text-secondary"><%= t("tenant.integration_guides.feishu.configuration.app_secret") %></label>
      <div><%= feishu_enterprise.app_secret.present? ? t("tenant.integration_guides.feishu.configuration.configured") : t("tenant.integration_guides.feishu.configuration.not_configured") %></div>
    </div>

    <div class="mb-3">
      <label class="form-label text-secondary"><%= t("tenant.integration_guides.feishu.configuration.app_verification_token") %></label>
      <div><%= feishu_enterprise.app_verification_token.present? ? t("tenant.integration_guides.feishu.configuration.configured") : t("tenant.integration_guides.feishu.configuration.not_configured") %></div>
    </div>

    <div class="mb-3">
      <label class="form-label text-secondary"><%= t("tenant.integration_guides.feishu.configuration.app_encrypt_key") %></label>
      <div><%= feishu_enterprise.app_encrypt_key.present? ? t("tenant.integration_guides.feishu.configuration.configured") : t("tenant.integration_guides.feishu.configuration.not_configured") %></div>
    </div>

    <div class="d-flex align-items-center">
      <%= link_to t("tenant.integration_guides.feishu.configuration.edit"),
                  @feishu_app_configuration_edit_path,
                  class: "btn btn-primary mb-0",
                  data: { turbo_frame: "feishu_app_configuration", turbo_stream: true } %>
      <%= button_to t("tenant.integration_guides.feishu.configuration.test_connection"),
                    @feishu_connection_test_path,
                    method: :post,
                    class: "btn btn-outline-primary ms-2 mb-0",
                    form: { class: "d-inline", data: { turbo: false } } %>
    </div>
  </div>
</div>
