<% content_for :title, t("tenant.integration_guides.feishu.page_title") %>
<%= render "tenant/shared/layout_slots" %>

<div class="container-fluid px-4 py-3">
  <div class="card mb-3">
    <div class="card-body">
      <h1 class="h4 mb-2"><%= t("tenant.integration_guides.feishu.title") %></h1>
      <p class="text-secondary mb-0"><%= t("tenant.integration_guides.feishu.description") %></p>
    </div>
  </div>

  <%= turbo_frame_tag "feishu_app_configuration" do %>
    <%= render(@editing_feishu_configuration ? "tenant/integration_guides/feishu_app_configuration_edit" : "tenant/integration_guides/feishu_app_configuration_show",
               feishu_enterprise: @feishu_enterprise) %>
  <% end %>

  <div class="card">
    <div class="card-body">
      <h2 class="h6"><%= t("tenant.integration_guides.feishu.sections.platform.title") %></h2>
      <ol class="mb-3">
        <li><%= t("tenant.integration_guides.feishu.sections.platform.item_1", entry_url: @feishu_entry_url) %></li>
        <li><%= t("tenant.integration_guides.feishu.sections.platform.item_2", callback_url: @feishu_callback_url) %></li>
        <li><%= t("tenant.integration_guides.feishu.sections.platform.item_3", events_url: @feishu_events_url) %></li>
        <li><%= t("tenant.integration_guides.feishu.sections.platform.item_4") %></li>
      </ol>

      <%= button_to t("tenant.integration_guides.feishu.start_oauth"),
                    @feishu_oauth_authorize_path,
                    method: :post,
                    class: "btn btn-primary",
                    form: { class: "d-inline", data: { turbo: false } } %>
    </div>
  </div>
</div>
