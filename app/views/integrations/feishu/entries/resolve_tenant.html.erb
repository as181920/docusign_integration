<% content_for :title, t("integrations.feishu.entries.resolve_tenant.page_title") %>

<div class="container-fluid px-4 py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-6">
      <div class="card">
        <div class="card-body">
          <h1 class="h5 mb-2"><%= @entry_error_title %></h1>
          <p class="text-secondary mb-3"><%= @entry_error_message %></p>

          <div class="alert alert-warning mb-3">
            <div><strong><%= t("integrations.feishu.entries.resolve_tenant.received_context") %></strong></div>
            <div><%= t("integrations.feishu.entries.resolve_tenant.context_tenant_uid") %>: <%= @submitted_tenant_uid.presence || t("tenant.common.empty") %></div>
            <div><%= t("integrations.feishu.entries.resolve_tenant.context_tenant_key") %>: <%= @submitted_tenant_key.presence || t("tenant.common.empty") %></div>
          </div>

          <p class="mb-2"><%= t("integrations.feishu.entries.resolve_tenant.form_hint") %></p>

          <%= form_with url: integrations_feishu_entry_path, method: :get, data: { turbo: false } do %>
            <div class="mb-3">
              <label for="entry_tenant_uid" class="form-label"><%= t("integrations.feishu.entries.resolve_tenant.tenant_uid_label") %></label>
              <%= text_field_tag :tenant_uid, @submitted_tenant_uid, id: "entry_tenant_uid", class: "form-control", required: true, placeholder: t("integrations.feishu.entries.resolve_tenant.tenant_uid_placeholder") %>
            </div>

            <% if @submitted_tenant_key.present? %>
              <%= hidden_field_tag :tenant_key, @submitted_tenant_key %>
            <% end %>

            <div class="d-flex justify-content-space-between align-items-center">
              <%= link_to t("integrations.feishu.entries.resolve_tenant.back_home"), root_path, class: "btn btn-outline-secondary" %>
              <%= button_tag t("integrations.feishu.entries.resolve_tenant.continue_button"), type: :submit, class: "btn btn-primary" %>
            </div>
          <% end %>

          <p class="text-secondary small mt-3 mb-0"><%= @entry_error_details %></p>
        </div>
      </div>
    </div>
  </div>
</div>
