<% content_for :title, t("tenant.integration_guides.feishu.page_title") %>
<%= render "tenant/shared/layout_slots" %>

<div class="container-fluid px-4 py-3">
  <div class="card mb-3">
    <div class="card-body">
      <h1 class="h4 mb-2"><%= t("tenant.integration_guides.feishu.title") %></h1>
      <p class="text-secondary mb-0"><%= t("tenant.integration_guides.feishu.description") %></p>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <h2 class="h6"><%= t("tenant.integration_guides.feishu.sections.preparation.title") %></h2>
      <ol class="mb-0">
        <li><%= t("tenant.integration_guides.feishu.sections.preparation.item_1") %></li>
        <li><%= t("tenant.integration_guides.feishu.sections.preparation.item_2") %></li>
      </ol>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <h2 class="h6"><%= t("tenant.integration_guides.feishu.sections.platform.title") %></h2>
      <ol class="mb-0">
        <li><%= t("tenant.integration_guides.feishu.sections.platform.item_1") %></li>
        <li><%= t("tenant.integration_guides.feishu.sections.platform.item_2", callback_url: @feishu_callback_url) %></li>
        <li><%= t("tenant.integration_guides.feishu.sections.platform.item_3", events_url: @feishu_events_url) %></li>
        <li><%= t("tenant.integration_guides.feishu.sections.platform.item_4") %></li>
      </ol>

      <div class="mt-3">
        <%= button_to t("tenant.integration_guides.feishu.start_oauth"), @feishu_oauth_authorize_path, method: :post, class: "btn btn-primary", form: { class: "d-inline", data: { turbo: false } } %>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <h2 class="h6"><%= t("tenant.integration_guides.feishu.sections.callback_params.title") %></h2>
      <ul class="mb-0">
        <li><%= t("tenant.integration_guides.feishu.sections.callback_params.item_1") %></li>
        <li><%= t("tenant.integration_guides.feishu.sections.callback_params.item_2") %></li>
        <li><%= t("tenant.integration_guides.feishu.sections.callback_params.item_3") %></li>
      </ul>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <h2 class="h6"><%= t("tenant.integration_guides.feishu.sections.access_entry.title") %></h2>
      <p class="text-secondary mb-2"><%= t("tenant.integration_guides.feishu.sections.access_entry.label") %></p>
      <p class="mb-0"><code><%= @access_entry_url %></code></p>
    </div>
  </div>
</div>
