default: &default
  adapter: postgresql
  encoding: unicode
  username: <%= ENV.fetch("PG_USERNAME", "dbuser") %>
  password: <%= ENV.fetch("PG_PASSWORD", "dbpassword") %>
  host: <%= ENV.fetch("PG_HOST", "127.0.0.1") %>
  port: <%= ENV.fetch("PG_PORT", "5432") %>
  pool: <%= ENV.fetch("RAILS_MAX_THREADS") { 7 } %>

development:
  primary:
    <<: *default
    database: docusign_integration_development
  cache:
    <<: *default
    database: docusign_integration_development_cache
    migrations_paths: db/cache_migrate
  queue:
    <<: *default
    database: docusign_integration_development_queue
    migrations_paths: db/queue_migrate
  cable:
    <<: *default
    database: docusign_integration_development_cable
    migrations_paths: db/cable_migrate

test:
  primary:
    <<: *default
    database: docusign_integration_test
  cache:
    <<: *default
    database: docusign_integration_test_cache
    migrations_paths: db/cache_migrate
  queue:
    <<: *default
    database: docusign_integration_test_queue
    migrations_paths: db/queue_migrate
  cable:
    <<: *default
    database: docusign_integration_test_cable
    migrations_paths: db/cable_migrate

production:
  primary: &primary_production
    <<: *default
    database: docusign_integration_production
    username: docusign_integration
    password: <%= ENV["DOCUSIGN_INTEGRATION_DATABASE_PASSWORD"] %>
  cache:
    <<: *primary_production
    database: docusign_integration_production_cache
    migrations_paths: db/cache_migrate
  queue:
    <<: *primary_production
    database: docusign_integration_production_queue
    migrations_paths: db/queue_migrate
  cable:
    <<: *primary_production
    database: docusign_integration_production_cable
    migrations_paths: db/cable_migrate
