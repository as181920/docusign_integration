<% content_for :title, t("tenant.docusign_connections.show.page_title") %>
<%= render "tenant/shared/layout_slots" %>

<% status_value = @connection&.status.presence || "unconnected" %>
<% status_label = t("tenant.docusign_connections.statuses.#{status_value}", default: status_value) %>
<% oauth_values = (@connection&.oauth_scope.presence || "signature").to_s.split(/[\s,]+/).reject(&:blank?) %>

<div class="container-fluid px-4 py-3">
  <div class="card mb-3">
    <div class="card-body">
      <h1 class="h5 mb-1"><%= t("tenant.docusign_connections.show.title") %></h1>
      <p class="text-secondary mb-0"><%= t("tenant.docusign_connections.show.description") %></p>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-12 col-xxl-8">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex justify-content-space-between align-items-center mb-3">
            <h2 class="h6 my-0"><%= t("tenant.docusign_connections.show.summary_title") %></h2>
            <% if @connection.present? %>
              <%= link_to t("tenant.docusign_connections.show.edit_button"), edit_tenant_docusign_connection_path(tenant_uid: current_tenant.uid), class: "btn btn-primary btn-sm my-0" %>
            <% end %>
          </div>

          <dl class="row mb-0">
            <dt class="col-4 text-secondary"><%= t("tenant.docusign_connections.show.fields.account_id") %></dt>
            <dd class="col-8 text-break"><%= @connection&.docusign_account_id.presence || t("tenant.common.empty") %></dd>

            <dt class="col-4 text-secondary"><%= t("tenant.docusign_connections.base_uri") %></dt>
            <dd class="col-8 text-break"><%= @connection&.docusign_base_uri.presence || t("tenant.common.empty") %></dd>

            <dt class="col-4 text-secondary"><%= t("tenant.docusign_connections.oauth_scope_label") %></dt>
            <dd class="col-8 text-break">
              <% oauth_values.each do |scope_value| %>
                <span class="badge bg-info me-1 mb-1"><%= t("tenant.docusign_connections.oauth_scope_options.#{scope_value}", default: scope_value) %></span>
              <% end %>
            </dd>

            <dt class="col-4 text-secondary"><%= t("tenant.docusign_connections.show.fields.status") %></dt>
            <dd class="col-8"><%= status_label %></dd>

            <dt class="col-4 text-secondary"><%= t("tenant.docusign_connections.show.fields.updated_at") %></dt>
            <dd class="col-8"><%= @connection&.updated_at ? l(@connection.updated_at, format: :long) : t("tenant.common.empty") %></dd>
          </dl>
        </div>
      </div>
    </div>

    <%= turbo_frame_tag "docusign_oauth_panel", class: "col-12 col-xxl-4" do %>
      <div class="card" id="docusign-oauth-panel">
        <div class="card-body">
          <h2 class="h6 mb-2"><%= t("tenant.docusign_connections.show.oauth_title") %></h2>
          <p class="text-secondary small mb-3"><%= t("tenant.docusign_connections.show.oauth_description") %></p>

          <%= form_with url: tenant_docusign_connection_oauth_authorization_path(tenant_uid: current_tenant.uid), method: :post, data: { turbo: false } do %>
            <%= hidden_field_tag "scopes[]", "" %>

            <div class="mb-3">
              <label class="form-label"><%= t("tenant.docusign_connections.oauth_scope_label") %></label>
              <% @oauth_scope_options.each do |scope_option| %>
                <label class="d-flex align-items-center mb-2">
                  <%= check_box_tag "scopes[]",
                    scope_option,
                    @selected_oauth_scopes.include?(scope_option),
                    class: "me-2" %>
                  <span><%= t("tenant.docusign_connections.oauth_scope_options.#{scope_option}", default: scope_option) %></span>
                </label>
              <% end %>
            </div>

            <%= button_tag type: :submit, class: "btn btn-primary w-100" do %>
              <%= tag.span class: "loading-spinner" %>
              <%= tag.span(@connection.present? ? t("tenant.docusign_connections.show.reauthorize_button") : t("tenant.docusign_connections.show.open_authorize_page")) %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
