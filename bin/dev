#!/usr/bin/env sh

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

port=""
while getopts "p:" opt; do
  case "$opt" in
    p)
      port="$OPTARG"
      ;;
    *)
      echo "Usage: $0 [-p PORT]"
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

if [ -n "$port" ]; then
  export PORT="$port"
elif [ -z "${PORT:-}" ]; then
  export PORT="3026"
fi

exec foreman start -f Procfile.dev "$@"
