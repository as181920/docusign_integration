<% content_for :title, "DocuSign Integration" %>

<style>
  .welcome-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    background: url(<%= image_path("easy_style/gray_bg.png") %>) 0 0 repeat;
    padding: 1rem;
  }

  .welcome-shell {
    max-width: 1080px;
    width: 100%;
    margin: 0 auto;
  }

  .welcome-hero {
    border: 0;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(28, 35, 56, 0.12);
    background: linear-gradient(108deg, #ff9e6d 0%, #fe6e68 45%, #e95353 100%);
    color: #fff;
  }

  .welcome-hero .hero-body {
    padding: 2.2rem 2rem;
  }

  .welcome-hero h1 {
    margin-bottom: 0.9rem;
    font-size: 2rem;
    line-height: 1.25;
  }

  .welcome-hero p {
    margin: 0;
    opacity: 0.95;
    font-size: 1rem;
    line-height: 1.75;
  }

  .welcome-actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .welcome-actions .btn {
    border: 0;
    border-radius: 999px;
    font-weight: 600;
    padding: 0.65rem 1.25rem;
  }

  .welcome-actions .btn-primary {
    color: #fff;
    background: linear-gradient(135deg, #f97316 0%, #ea580c 45%, #dc2626 100%);
    box-shadow: 0 8px 18px rgba(234, 88, 12, 0.28);
  }

  .welcome-actions .btn-primary:hover,
  .welcome-actions .btn-primary:focus {
    color: #fff;
    background: linear-gradient(135deg, #ea580c 0%, #c2410c 45%, #b91c1c 100%);
  }

  .welcome-actions .btn-outline-light {
    border: 1px solid rgba(255, 255, 255, 0.6);
    color: #fff;
    background: transparent;
  }

  .welcome-grid {
    margin-top: 1.25rem;
  }

  .welcome-card {
    border: 0;
    border-radius: 0.9rem;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
    height: 100%;
  }

  .welcome-card .card-body {
    padding: 1.15rem 1.2rem;
  }

  .welcome-kicker {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: 0.35rem;
  }

  .welcome-value {
    font-size: 1.35rem;
    font-weight: 700;
    color: #0f172a;
  }

  .welcome-section-title {
    margin-top: 1.6rem;
    margin-bottom: 0.7rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: #1f2937;
  }

  .welcome-feature {
    border: 1px solid #e5e7eb;
    border-radius: 0.8rem;
    background: #fff;
    padding: 1rem;
    height: 100%;
  }

  .welcome-feature h3 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    color: #111827;
  }

  .welcome-feature p {
    margin: 0;
    color: #6b7280;
    line-height: 1.65;
    font-size: 0.92rem;
  }

  .welcome-demo {
    margin-top: 1.1rem;
    border: 1px dashed #cbd5e1;
    border-radius: 0.8rem;
    padding: 0.9rem 1rem;
    background: #fff;
  }

  .welcome-demo code {
    background: #f1f5f9;
    border-radius: 0.35rem;
    padding: 0.1rem 0.35rem;
  }

  @media (max-width: 768px) {
    .welcome-hero .hero-body {
      padding: 1.4rem 1.15rem;
    }

    .welcome-hero h1 {
      font-size: 1.55rem;
    }
  }
</style>

<main class="welcome-page">
  <div class="welcome-shell">
    <section class="card welcome-hero">
      <div class="hero-body">
        <div class="welcome-kicker text-white">Cross-border Contract Flow</div>
        <h1>合同管理中台</h1>
        <p>
          面向商家侧统一管理 DocuSign 授权、合同模板、签署人配置、发起签署和回调接收，支持嵌入式签署与邮件签署两种模式。
        </p>

        <div class="welcome-actions">
          <%= @signed_in_tenant_user.present? ? link_to("进入控制台", tenant_dashboard_path(tenant_uid: @dashboard_tenant_uid), class: "btn btn-primary") : link_to("商家登录", tenant_auth.iam_sign_in_path(tenant_uid: @demo_tenant_uid, redirect_url: tenant_dashboard_path(tenant_uid: @demo_tenant_uid)), class: "btn btn-primary") %>
          <%#= link_to "查看示例商家流程", tenant_dashboard_path(tenant_uid: @demo_tenant_uid), class: "btn btn-outline-light" %>
        </div>
      </div>
    </section>

    <section class="welcome-demo">
      <div><strong>体验账户：</strong><code><%= @demo_tenant_uid %></code></div>
      <div><strong>体验账号：</strong><code>demo</code> / <code>password</code></div>
    </section>
  </div>
</main>
