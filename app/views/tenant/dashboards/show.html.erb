<% content_for :title, t("tenant.dashboards.page_title") %>
<% content_for :custom_sidebar do %>
  <%= render "shared/sidebar" %>
<% end %>
<% content_for :custom_header do %>
  <%= render "shared/header" %>
<% end %>

<div class="container-fluid px-4 py-3">
  <div class="card mb-3">
    <div class="card-body">
      <h1 class="h4 mb-2"><%= t("tenant.dashboards.welcome_title") %></h1>
      <p class="text-secondary mb-0"><%= t("tenant.dashboards.enterprise_label") %>：<strong><%= current_tenant.name %></strong>（<code><%= current_tenant.uid %></code>）</p>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-12 col-lg-3">
      <div class="card h-100">
        <div class="card-body">
          <h2 class="h6"><%= t("tenant.dashboards.cards.docusign_connection.title") %></h2>
          <p class="text-secondary mb-3"><%= t("tenant.dashboards.cards.docusign_connection.description") %></p>
          <%= link_to t("tenant.dashboards.actions.enter"), tenant_docusign_connection_path(tenant_uid: current_tenant.uid), class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-3">
      <div class="card h-100">
        <div class="card-body">
          <h2 class="h6"><%= t("tenant.dashboards.cards.contract_templates.title") %></h2>
          <p class="text-secondary mb-3"><%= t("tenant.dashboards.cards.contract_templates.description") %></p>
          <%= link_to t("tenant.dashboards.actions.enter"), tenant_contract_templates_path(tenant_uid: current_tenant.uid), class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-3">
      <div class="card h-100">
        <div class="card-body">
          <h2 class="h6"><%= t("tenant.dashboards.cards.contracts.title") %></h2>
          <p class="text-secondary mb-3"><%= t("tenant.dashboards.cards.contracts.description") %></p>
          <%= link_to t("tenant.dashboards.actions.enter"), tenant_contracts_path(tenant_uid: current_tenant.uid), class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-3">
      <div class="card h-100">
        <div class="card-body">
          <h2 class="h6"><%= t("tenant.dashboards.cards.webhook_events.title") %></h2>
          <p class="text-secondary mb-3"><%= t("tenant.dashboards.cards.webhook_events.description") %></p>
          <%= link_to t("tenant.dashboards.actions.enter"), tenant_webhook_events_path(tenant_uid: current_tenant.uid), class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>
  </div>
</div>
